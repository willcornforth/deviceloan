{
  "name": "deviceloan-products-service",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "seed": "npm run build && node -r ./scripts/load-settings.js dist/src/seed/run-seed.js",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/cosmos": "^4.7.0",
    "@azure/eventgrid": "^5.12.0",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/ui": "^4.0.15",
    "azure-functions-core-tools": "^4.x",
    "rimraf": "^5.0.0",
    "typescript": "^4.0.0",
    "vitest": "^4.0.15"
  }
}
