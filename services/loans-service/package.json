{
  "name": "deviceloan-loans-service",
  "version": "1.0.0",
  "description": "Device Loan Service",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@azure/cosmos": "^4.8.0",
    "@azure/eventgrid": "^5.12.0",
    "@azure/functions": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@vitest/ui": "^4.0.15",
    "azure-functions-core-tools": "^4.x",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^4.0.15"
  }
}
